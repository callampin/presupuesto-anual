{
  "name": "presupuesto-personal",
  "productName": "Presupuesto Personal",
  "version": "1.1.0",
  "private": true,
  "description": "Sistema personal de finanzas y presupuesto local (reemplazo de PRESUPUESTO.xlsx)",
  "homepage": "https://github.com/callampin/presupuesto-anual",
  "repository": {
    "type": "git",
    "url": "https://github.com/callampin/presupuesto-anual.git"
  },
  "desktopName": "presupuesto-personal.desktop",
  "author": {
    "name": "Presupuesto Personal"
  },
  "type": "module",
  "main": "dist-electron/main.js",
  "packageManager": "pnpm@11.5.0",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:electron": "node scripts/dev.mjs --electron",
    "dev:stop": "node scripts/dev.mjs --stop",
    "dev:server": "tsx watch src/server/index.ts",
    "dev:client": "vite",
    "build": "vite build && node scripts/build-electron.mjs",
    "build:web": "vite build",
    "build:electron": "node scripts/build-electron.mjs",
    "start": "tsx src/server/index.ts",
    "start:electron": "electron .",
    "package": "pnpm build && electron-builder --publish never",
    "package:linux": "pnpm build && electron-builder --linux --publish never",
    "package:win": "pnpm build && electron-builder --win --publish never",
    "package:dir": "pnpm build && electron-builder --dir --publish never",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit",
    "db:push": "drizzle-kit push"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.13",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@fontsource-variable/familjen-grotesk": "^5.3.0",
    "@fontsource/dm-mono": "^5.3.0",
    "@hono/node-server": "^2.1.5",
    "@playwright/test": "1.57.0",
    "@tanstack/react-query": "^5.104.5",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "autoprefixer": "^10.6.1",
    "clsx": "^2.1.1",
    "drizzle-kit": "^0.31.11",
    "electron": "45.0.0",
    "electron-builder": "26.18.0",
    "esbuild": "0.25.12",
    "lucide-react": "^1.61.0",
    "postcss": "^8.5.31",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "recharts": "^3.10.1",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^7.3.7",
    "vitest": "^3.2.7"
  }
}
